{
  "name": "promptdock",
  "version": "6.0.0",
  "description": "The Real Interactive Creative Developer Platform — Live Component Playground (21st.dev), Creative Effects Registry (Libraries.dev), AI Agent Workflows, and 3D WebGL Engine.",
  "scripts": {
    "dev": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{const p=path.join(__dirname,req.url==='/'?'index.html':req.url);if(fs.existsSync(p)){res.writeHead(200,{'Content-Type':p.endsWith('.html')?'text/html':p.endsWith('.svg')?'image/svg+xml':'text/plain'});fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not Found');}}).listen(3000,()=>console.log('Dev server running on http://localhost:3000'))\"",
    "start": "npm run dev",
    "lint": "node lint.js",
    "typecheck": "node typecheck.js",
    "test": "node test-build.js",
    "test:e2e": "node test-e2e.js",
    "build": "node build.js",
    "validate": "node lint.js && node typecheck.js && node test-build.js && node test-e2e.js && node build.js"
  },
  "keywords": [
    "prompts",
    "ai",
    "animations",
    "threejs",
    "webgl",
    "gsap",
    "tailwind",
    "21st.dev",
    "libraries.dev",
    "nextjs",
    "component-playground",
    "creative-developer"
  ],
  "author": "kalyan870",
  "license": "MIT"
}
